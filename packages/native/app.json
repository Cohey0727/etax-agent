{
  "expo": {
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#18124d",
        "backgroundImage": "./assets/adaptive-background.png",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "package": "jp.co.occam.etaxagent"
    },
    "backgroundColor": "#18124d",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "00000000-0000-0000-0000-000000000000"
      }
    },
    "icon": "./assets/icon.png",
    "ios": {
      "bundleIdentifier": "jp.co.occam.etaxagent",
      "supportsTablet": false
    },
    "name": "eTaxAgent",
    "orientation": "portrait",
    "plugins": [
      "expo-router",
      "expo-updates",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#18124d",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      "expo-sharing",
      "expo-font",
      [
        "expo-image-picker",
        {
          "cameraPermission": "領収書や書類を撮影するためにカメラを使用します。",
          "photosPermission": "領収書や書類の画像を選ぶために写真へのアクセスを使用します。"
        }
      ]
    ],
    "scheme": "etaxagent",
    "slug": "etaxagent",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "checkAutomatically": "ON_LOAD",
      "enabled": false,
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/00000000-0000-0000-0000-000000000000"
    },
    "userInterfaceStyle": "light",
    "version": "0.1.0"
  }
}
