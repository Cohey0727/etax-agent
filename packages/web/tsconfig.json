{
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "paths": {
      "@configs": ["./src/configs"],
      "@components/*": ["./src/components/*"],
      "@types": ["./src/types"],
      "@types/*": ["./src/types/*"],
      "@utils": ["./src/utils"],
      "@utils/*": ["./src/utils/*"]
    }
  },
  "extends": "../../tsconfig.base.json",
  "include": ["src", "vite.config.ts"]
}
