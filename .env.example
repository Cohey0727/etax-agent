# --- データベース（PostgreSQL 19） ---
# docker compose で起動する場合は、リポジトリ直下の .env に POSTGRES_PASSWORD を
# 置けばよい（DATABASE_URL は compose が組み立てる）。パスワードは英数字のみ。
# POSTGRES_USER=etax
# POSTGRES_PASSWORD=
# POSTGRES_DB=etaxagent
# compose を使わずサーバーを直接起動する場合は接続文字列を直接指定する。
# DATABASE_URL=postgres://etax:etax@localhost:5432/etaxagent

# --- 運用データ（アップロードファイル・学習履歴の置き場） ---
# 未指定なら packages/server/data。
# ETAX_DATA_DIR=/path/to/data

# --- サーバー ---
PORT=3001

# --- MCP（外部エージェント連携 /mcp の認証） ---
# 設定すると /mcp は Authorization: Bearer <この値> を必須にする。
# 未設定なら認証なし（ローカル前提。インターネットに公開する場合は必ず設定）。
# MCP_TOKEN=

# --- LLM エージェント（CSV自動マッピング / 対話エージェント用） ---
# openai = OpenAI互換（既定は OpenRouter）。claude = Anthropic Messages API。
AGENT_SCHEMA=openai
AGENT_API_KEY=
# AGENT_BASE_URL=https://openrouter.ai/api/v1
# AGENT_MODEL=openai/gpt-4o-mini

# --- 認証（SaaS運用でログイン必須にする場合） ---
# required にすると全画面でログインが必須になる（登録時のメール確認も必須）。
# ローカル運用では未設定のままでよい。
# ETAX_AUTH_MODE=required
# ログイン・チャレンジの署名鍵。未設定時は ETAX_ENCRYPTION_KEY を使う。
# ETAX_AUTH_SECRET=
# 機微項目（マイナンバー・TOTP秘密）の保存時暗号化キー。
# 未設定だと平文で保存されるため、公開運用では必ず設定する。
# ETAX_ENCRYPTION_KEY=
# メールリンク・OAuth戻り先の生成に使う公開オリジン（例: https://example.com）。
# ETAX_PUBLIC_URL=
# 許可する Origin の上書き（カンマ区切り）。
# ETAX_CORS_ORIGINS=

# --- 外部ログイン（使うものだけ設定） ---
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# --- メール送信（マジックリンク・メール確認。Resend） ---
# RESEND_API_KEY=
# RESEND_FROM=

# --- 課金（Stripe。未設定だと課金は「準備中」表示） ---
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_ID=

# --- 科目判定AI（外部LLM）の接続上書き ---
# SYSTEMONE_API_KEY=
# SYSTEMONE_BASE_URL=
# SYSTEMONE_MODEL=
