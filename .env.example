# --- データベース（docker compose の Postgres 18 に合わせた例） ---
DATABASE_URL=postgres://etax:etax@localhost:5433/etaxagent

# --- サーバー ---
PORT=3001

# --- LLM エージェント（CSV自動マッピング / 対話エージェント用） ---
# openai = OpenAI互換（既定は OpenRouter）。claude = Anthropic Messages API。
AGENT_SCHEMA=openai
AGENT_API_KEY=
# AGENT_BASE_URL=https://openrouter.ai/api/v1
# AGENT_MODEL=openai/gpt-4o-mini

# --- ファイルストレージ（Garage / S3互換） ---
# 署名付きURLの発行先（ブラウザから到達できる公開URL）と、取得用の内部URL。
# docker compose では S3_PUBLIC_ENDPOINT / S3_INTERNAL_ENDPOINT は
# compose 側で上書きされる。キーは Garage のキー発行で得たものを入れる。
# S3_PUBLIC_ENDPOINT=https://mini-files.spaghetti-monster.com
# S3_INTERNAL_ENDPOINT=http://garage:3900
# S3_BUCKET=etax-files
# S3_REGION=garage
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
